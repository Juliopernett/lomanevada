---
import { Image } from 'astro:assets';
import PageHead from '../components/PageHead.astro';
import Gallery from '../components/Gallery.astro';
import Cards from '../components/Cards.astro';
import Sections from '../components/Sections.astro';
import Icon from '../components/Icon.astro';
import { img } from '../lib/img';
import { PASADIA, TRANSPORT, TOURS, TREK_POINTS, COMMON_STAY, UI, waLink, type Lang, type Service } from '../data/site';

interface Props { lang: Lang; service: Service }
const { lang, service } = Astro.props;
const es = lang === 'es';
const t = service.title[lang];
const wa = waLink(es ? `Hola, quiero información sobre: ${t}` : `Hi, I would like information about: ${t}`);
const flyerAlt = es ? `Afiche de ${t}` : `${t} poster`;
---
<PageHead lang={lang} title={t} parent={{ label: UI.services[lang] }} lead={service.intro[lang]} />

<section class="section" style="padding-top:24px">
  <div class="wrap svc">
    <div class="svc__main">
      {service.key === 'pasadia' && (
        <>
          <div class="price">
            <strong>{PASADIA.price}</strong>
            <span>{PASADIA.perPerson[lang]} · {PASADIA.hours[lang]}</span>
          </div>
          <h2>{es ? 'Podrás disfrutar' : 'You can enjoy'}</h2>
          <ul class="checks">{PASADIA.includes[lang].map((i) => <li>{i}</li>)}</ul>
          <p class="note">{PASADIA.consumableNote[lang]}</p>
          <p>{PASADIA.kids[lang]}</p>
        </>
      )}

      {service.key === 'transporte' && (
        <>
          <p class="lead">{TRANSPORT.summary[lang]}</p>
          <ol class="route">
            {TRANSPORT.legs.map((l) => (
              <li>
                <div class="route__head"><strong>{l.from} → {l.to}</strong><span>{l.km} km · {l.min} min</span></div>
                <p>{l.how[lang]}</p>
                <small>{l.from} {l.fromAlt.toLocaleString(es ? 'es-CO' : 'en-US')} msnm → {l.to} {l.toAlt.toLocaleString(es ? 'es-CO' : 'en-US')} msnm</small>
              </li>
            ))}
          </ol>
          <p class="note">{TRANSPORT.ask[lang]}</p>
          <ul>{TRANSPORT.notes[lang].map((n) => <li>{n}</li>)}</ul>
        </>
      )}

      {service.key === 'restaurante' && (
        <>
          <p>{es ? 'Nuestro restaurante ofrece las tres comidas del día con una espectacular vista 360° al mar Caribe, la Ciénaga Grande de Santa Marta y la Sierra Nevada. En el bar encontrarás cervezas extranjeras, nacionales y regionales, whisky, aguardiente, vodka, ron, brandy y tequila, entre otros.' : 'Our restaurant serves all three meals with a spectacular 360° view of the Caribbean Sea, the Ciénaga Grande de Santa Marta and the Sierra Nevada. At the bar you will find imported, national and regional beers, whisky, aguardiente, vodka, rum, brandy and tequila, among others.'}</p>
          <div class="qr">
            <Image src={img('servicios/carta-qr.png')} alt={es ? 'Código QR de la carta del restaurante' : 'Restaurant menu QR code'} width={200} />
            <div>
              <h2>{es ? 'Escanea la carta' : 'Scan the menu'}</h2>
              <p>{es ? 'Escanea el código con la cámara de tu celular para ver la carta del restaurante.' : 'Scan the code with your phone camera to see the restaurant menu.'}</p>
            </div>
          </div>
        </>
      )}

      {service.key === 'recorridos' && (
        <div class="table-scroll">
          <table class="data">
            <thead><tr><th>#</th><th>{es ? 'Destino' : 'Destination'}</th><th>{es ? 'Salida' : 'Departure'}</th><th>{es ? 'Cómo se llega' : 'How to get there'}</th><th>{es ? 'Tiempo' : 'Time'}</th><th>{es ? 'Valor por persona' : 'Price per person'}</th></tr></thead>
            <tbody>
              {TOURS.map((tour, i) => (
                <tr>
                  <td>{i + 1}</td>
                  <td><strong>{tour.dest[lang]}</strong>{tour.note && <><br /><small>{tour.note[lang]}</small></>}</td>
                  <td>{tour.time}</td><td>{tour.how[lang]}</td><td>{tour.duration[lang]}</td><td><strong>COP {tour.price}</strong></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {service.key === 'wifi' && (
        <>
          <p>{es ? 'Conéctate gratis en todas nuestras zonas comunes:' : 'Connect for free in all our common areas:'}</p>
          <ul class="checks">{COMMON_STAY.wifi[lang].split(':')[1].split(/,| y | and /).map((s) => <li>{s.trim().replace(/^./, (c) => c.toUpperCase())}</li>)}</ul>
        </>
      )}

      {service.key === 'senderismo' && (
        <>
          <p>{es ? 'Una ruta circular de 27,3 km que baja desde Loma Nevada hasta Minca y regresa por La Victoria, pasando por cascadas, pozos y fincas cafeteras.' : 'A 27.3 km loop that descends from Loma Nevada to Minca and returns through La Victoria, passing waterfalls, pools and coffee farms.'}</p>
          <div class="table-scroll">
            <table class="data">
              <thead><tr><th>{es ? 'Punto' : 'Point'}</th><th>{es ? 'Lugar' : 'Place'}</th><th>{es ? 'Altura (m)' : 'Height (m)'}</th></tr></thead>
              <tbody>{TREK_POINTS.map((p) => <tr><td>{p.n}</td><td>{p.place}</td><td>{p.alt}</td></tr>)}</tbody>
            </table>
          </div>
        </>
      )}

      <a class="btn btn--wa" style="margin-top:28px" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" />{es ? 'Pregunta por WhatsApp' : 'Ask on WhatsApp'}</a>
    </div>

    <div class="svc__flyer">
      <Gallery images={service.images} alt={flyerAlt} lang={lang} />
    </div>
  </div>
</section>

<section class="section section--alt">
  <div class="wrap">
    <h2>{es ? 'Otros servicios' : 'Other services'}</h2>
    <div style="margin-top:24px"><Cards lang={lang} kind="services" exclude={service.key} /></div>
  </div>
</section>
<Sections lang={lang} show={['stays']} />

<style>
  .svc { display: grid; gap: 40px; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); align-items: start; }
  @media (max-width: 900px) { .svc { grid-template-columns: minmax(0, 1fr); } }
  .svc__flyer :global(.gal) { grid-template-columns: 1fr; }
  .svc__flyer :global(.gal__item img) { aspect-ratio: auto; object-fit: contain; background: #fff; }
  .price { display: inline-flex; flex-direction: column; background: var(--green); color: #fff; padding: 18px 24px; border-radius: var(--radius); margin-bottom: 28px; }
  .price strong { font: 600 2.2rem/1.1 var(--font-head); }
  .checks { list-style: none; padding: 0; display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
  .checks li { padding-left: 30px; position: relative; }
  .checks li::before { content: '✓'; position: absolute; left: 0; top: 0; width: 22px; height: 22px; border-radius: 50%; background: var(--green-soft); color: var(--green-dark); display: grid; place-items: center; font-size: .8rem; font-weight: 700; }
  .note { background: #fdf3e2; border-left: 4px solid var(--sun); padding: 12px 16px; border-radius: 8px; }
  .route { list-style: none; padding: 0; margin: 24px 0; display: grid; gap: 14px; counter-reset: r; }
  .route li { background: var(--white); border-radius: 12px; padding: 16px 18px 16px 58px; position: relative; border: 1px solid var(--line); counter-increment: r; }
  .route li::before { content: counter(r); position: absolute; left: 16px; top: 16px; width: 28px; height: 28px; border-radius: 50%; background: var(--sun); color: #fff; display: grid; place-items: center; font-weight: 700; }
  .route__head { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 6px; }
  .route__head span { color: var(--green-dark); font-weight: 600; }
  .route p { margin: 6px 0 2px; }
  .route small { color: var(--muted); }
  .qr { display: flex; gap: 24px; align-items: center; background: var(--white); padding: 20px; border-radius: var(--radius); box-shadow: var(--shadow); margin-top: 24px; flex-wrap: wrap; }
  .qr :global(img) { width: 160px; }
</style>
