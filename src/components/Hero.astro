---
// Hero inmersivo: foto a pantalla completa que cambia lentamente, nombre del hotel,
// una frase, un solo botón principal y la barra de reserva (escritorio).
// Solo la primera foto se carga de entrada (y se precarga en el <head>).
import { getImage } from 'astro:assets';
import Icon from './Icon.astro';
import BookingForm from './BookingForm.astro';
import { img, HERO } from '../lib/img';
import { BOOK, SITE, UI, UX, type Lang } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const es = lang === 'es';
const slides = await Promise.all(
  HERO.map(async (p) => {
    const r = await getImage({ src: img(p), widths: [640, 960, 1200], format: 'webp' });
    return { src: r.src, srcset: r.srcSet.attribute };
  }),
);
---
<section class="hero" aria-label={SITE.name}>
  <div class="hero__media" aria-hidden="true">
    {slides.map((s, i) =>
      i === 0 ? (
        <img src={s.src} srcset={s.srcset} sizes="100vw" alt="" class="is-active" fetchpriority="high" width="1200" height="700" />
      ) : (
        <img data-src={s.src} data-srcset={s.srcset} sizes="100vw" alt="" width="1200" height="700" />
      ),
    )}
  </div>
  <div class="hero__shade"></div>

  <div class="hero__content">
    <p class="hero__kicker">Minca · Sierra Nevada de Santa Marta · 1.500 m</p>
    <h1 class="hero__title">
      <span class="hero__name">Loma Nevada</span>
      <span class="hero__line">{es ? <>Duerme <em>sobre las nubes,</em> frente al mar Caribe</> : <>Sleep <em>above the clouds,</em> facing the Caribbean Sea</>}</span>
    </h1>
    <div class="hero__cta">
      <button type="button" class="btn" data-open-booking>{UX.reserveNow[lang]}</button>
      <a class="hero__link" href="#cabanas">{es ? 'Ver cabañas' : 'View cabins'} <Icon name="arrow" /></a>
    </div>
  </div>

  <div class="hero__foot">
    <div class="hero__info">
      <a href={SITE.mapsUrl} target="_blank" rel="noopener" class="hero__rating"><span class="stars" aria-hidden="true">★★★★★</span> {SITE.rating}/5 · {UI.avgRating[lang]}</a>
      <span class="hero__weather" hidden data-weather data-label={BOOK.weatherNow[lang]}></span>
    </div>
    <div class="hero__booking">
      <BookingForm lang={lang} variant="bar" />
    </div>
  </div>
</section>

<script>
  // Carrusel lento con cruce suave; cada foto se pide justo antes de mostrarse.
  const imgs = [...document.querySelectorAll<HTMLImageElement>('.hero__media img')];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const load = (im: HTMLImageElement) => {
    if (im.dataset.srcset) { im.srcset = im.dataset.srcset; im.src = im.dataset.src!; delete im.dataset.srcset; }
  };
  if (imgs.length > 1 && !reduce) {
    addEventListener('load', () => {
      let i = 0;
      load(imgs[1]);
      setInterval(() => {
        const next = (i + 1) % imgs.length;
        if (!imgs[next].complete) return;
        imgs[i].classList.remove('is-active');
        imgs[next].classList.add('is-active');
        i = next;
        load(imgs[(i + 1) % imgs.length]);
      }, 7000);
    });
  }

  // Clima en vivo (Open-Meteo, gratis y sin clave). Si falla, no se muestra.
  const w = document.querySelector<HTMLElement>('[data-weather]');
  if (w) {
    fetch('https://api.open-meteo.com/v1/forecast?latitude=11.12&longitude=-74.07&elevation=1495&current=temperature_2m&timezone=America%2FBogota')
      .then((r) => r.json())
      .then((d) => {
        const t = d?.current?.temperature_2m;
        if (typeof t !== 'number') return;
        w.textContent = `${Math.round(t)} °C ${w.dataset.label}`;
        w.hidden = false;
      })
      .catch(() => {});
  }
</script>

<style>
  .hero { position: relative; min-height: 100svh; display: grid; grid-template-rows: 1fr auto; color: #fff; overflow: hidden; background: var(--forest); isolation: isolate; }
  .hero__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transform: scale(1.08); transition: opacity 2s ease; z-index: -2; }
  .hero__media img.is-active { opacity: 1; animation: drift 12s ease-out forwards; }
  @keyframes drift { from { transform: scale(1.08); } to { transform: scale(1); } }
  .hero__shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgb(10 16 12 / .55) 0%, rgb(10 16 12 / .05) 30%, rgb(10 16 12 / .15) 55%, rgb(10 16 12 / .8) 100%); }

  /* Sombra suave para que el texto blanco se lea sobre cualquier foto */
  .hero__content, .hero__info { text-shadow: 0 1px 2px rgb(0 0 0 / .35), 0 2px 18px rgb(0 0 0 / .35); }
  .hero__content .btn { text-shadow: none; }
  .hero__content { align-self: center; justify-self: center; text-align: center; padding: 120px 20px 40px; max-width: 980px; }
  .hero__kicker { font: 600 .74rem/1.4 var(--font-body); letter-spacing: .26em; text-transform: uppercase; margin: 0 0 1.6rem; opacity: .92; }
  .hero__title { color: #fff; margin: 0; font-weight: 300; }
  .hero__name { display: block; font-size: clamp(3.4rem, 11vw, 9rem); line-height: .92; letter-spacing: -.03em; }
  .hero__line { display: block; margin-top: .6em; font-size: clamp(1.15rem, 2.4vw, 1.8rem); line-height: 1.3; font-weight: 300; }
  .hero__line em { font-style: italic; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 14px 28px; justify-content: center; align-items: center; margin-top: 2.4rem; }
  .hero__link { position: relative; display: inline-flex; align-items: center; gap: 8px; color: #fff; text-decoration: none; font-weight: 600; font-size: .95rem; border-bottom: 1.5px solid rgb(255 255 255 / .7); padding-bottom: 3px; }
  .hero__link::after { content: ''; position: absolute; inset: -12px -8px; }
  .hero__link :global(svg) { width: 16px; height: 16px; transform: rotate(90deg); }

  /* Entrada del texto */
  .hero__kicker, .hero__name, .hero__line, .hero__cta { animation: rise 1.2s var(--ease) both; }
  .hero__name { animation-delay: .1s; }
  .hero__line { animation-delay: .25s; }
  .hero__cta { animation-delay: .4s; }
  @keyframes rise { from { opacity: 0; transform: translateY(24px); } }

  .hero__foot { width: min(100% - 32px, var(--wrap)); margin: 0 auto; padding-bottom: 24px; }
  .hero__info { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 20px; font-size: .82rem; margin-bottom: 14px; }
  .hero__rating { color: #fff; text-decoration: none; opacity: .92; padding: 10px 0; }
  .hero__rating:hover { opacity: 1; text-decoration: underline; }
  .stars { color: #e9c46a; letter-spacing: 2px; }
  .hero__weather { opacity: .92; }

  @media (max-width: 760px) {
    .hero__kicker { font-size: .8rem; letter-spacing: .18em; }
    .hero__booking { display: none; }
    .hero__content { padding-top: 96px; }
    .hero__info { justify-content: center; text-align: center; }
  }
</style>
