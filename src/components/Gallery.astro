---
// Galería con visor a pantalla completa (lightbox). Las miniaturas se cargan diferidas.
import { Image, getImage } from 'astro:assets';
import { img } from '../lib/img';
import { UI, type Lang } from '../data/site';

interface Props { images: string[]; alt: string; lang: Lang; variant?: 'grid' | 'feature' }
const { images, alt, lang, variant = 'grid' } = Astro.props;

const items = await Promise.all(
  images.map(async (p, i) => {
    const full = await getImage({ src: img(p), width: 1600, format: 'webp' });
    return { src: img(p), full: full.src, alt: `${alt} – ${i + 1}` };
  }),
);
---
<div class:list={['gal', `gal--${variant}`]} data-gallery>
  {items.map((it, i) => (
    <a href={it.full} class:list={['gal__item', variant === 'feature' && i > 4 && 'gal__item--hidden']} data-index={i} data-more={variant === 'feature' && i === 4 && items.length > 5 ? `+${items.length - 5}` : undefined}>
      <Image src={it.src} alt={it.alt} quality={72} widths={[400, 720, 1000]} sizes={variant === 'feature' && i === 0 ? '(max-width: 760px) 66vw, 66vw' : '(max-width: 760px) 50vw, 33vw'} loading={i === 0 && variant === 'feature' ? 'eager' : 'lazy'} fetchpriority={i === 0 && variant === 'feature' ? 'high' : undefined} />
    </a>
  ))}
  <dialog class="lb" aria-label={UI.gallery[lang]}>
    <img class="lb__img" alt="" />
    <button class="lb__btn lb__close" aria-label={UI.close[lang]}>✕</button>
    <button class="lb__btn lb__prev" aria-label={UI.prev[lang]}>‹</button>
    <button class="lb__btn lb__next" aria-label={UI.next[lang]}>›</button>
    <span class="lb__count"></span>
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gal) => {
    const links = [...gal.querySelectorAll<HTMLAnchorElement>('.gal__item')];
    const dlg = gal.querySelector('dialog')!;
    const im = dlg.querySelector<HTMLImageElement>('.lb__img')!;
    const count = dlg.querySelector<HTMLElement>('.lb__count')!;
    let idx = 0;
    const show = (i: number) => {
      idx = (i + links.length) % links.length;
      im.src = links[idx].href;
      im.alt = links[idx].querySelector('img')?.alt ?? '';
      count.textContent = `${idx + 1} / ${links.length}`;
    };
    links.forEach((a, i) => a.addEventListener('click', (e) => { e.preventDefault(); show(i); dlg.showModal(); }));
    dlg.querySelector('.lb__close')!.addEventListener('click', () => dlg.close());
    dlg.querySelector('.lb__prev')!.addEventListener('click', () => show(idx - 1));
    dlg.querySelector('.lb__next')!.addEventListener('click', () => show(idx + 1));
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(idx - 1);
      if (e.key === 'ArrowRight') show(idx + 1);
    });
    let x0 = 0;
    dlg.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    dlg.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 50) show(idx + (dx < 0 ? 1 : -1)); });
  });
</script>

<style>
  .gal { display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(min(46%, 220px), 1fr)); }
  .gal__item { display: block; border-radius: 10px; overflow: hidden; cursor: zoom-in; background: var(--line); }
  .gal__item :global(img) { width: 100%; height: 100%; aspect-ratio: 4 / 3; object-fit: cover; transition: transform .4s; }
  .gal__item:hover :global(img) { transform: scale(1.04); }
  .gal--feature { grid-template-columns: repeat(4, 1fr); }
  .gal__item--hidden { display: none; }
  .gal__item[data-more] { position: relative; }
  .gal__item[data-more]::after { content: attr(data-more); position: absolute; inset: 0; display: grid; place-items: center; background: rgb(20 16 6 / .5); color: #fff; font: 600 1.6rem/1 var(--font-head); }
  .gal--feature .gal__item:first-child { grid-column: span 2; grid-row: span 2; }
  @media (max-width: 760px) {
    .gal--feature { grid-template-columns: repeat(2, 1fr); }
  }

  .lb { border: 0; padding: 0; background: transparent; max-width: 100vw; max-height: 100vh; width: 100vw; height: 100vh; }
  .lb::backdrop { background: rgb(15 13 8 / .92); }
  .lb[open] { display: grid; place-items: center; }
  .lb__img { max-width: min(94vw, 1600px); max-height: 86vh; object-fit: contain; border-radius: 6px; }
  .lb__btn { position: fixed; background: rgb(255 255 255 / .14); color: #fff; border: 0; width: 48px; height: 48px; border-radius: 50%; font-size: 26px; line-height: 1; cursor: pointer; display: grid; place-items: center; }
  .lb__btn:hover { background: rgb(255 255 255 / .28); }
  .lb__close { top: 16px; right: 16px; font-size: 20px; }
  .lb__prev { left: 12px; top: 50%; transform: translateY(-50%); }
  .lb__next { right: 12px; top: 50%; transform: translateY(-50%); }
  .lb__count { position: fixed; bottom: 18px; left: 50%; transform: translateX(-50%); color: #ddd; font-size: .9rem; }
</style>
