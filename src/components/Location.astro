---
// Ubicación: foto, distancias reales, mapa bajo demanda y cómo llegar.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { img } from '../lib/img';
import { DISTANCES, PAGES, SERVICES, SITE, UI, UX, href, waLink, type Lang } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const es = lang === 'es';
const transport = SERVICES.find((s) => s.key === 'transporte')!;
---
<section class="section loc" id="ubicacion" aria-labelledby="loc-title">
  <div class="wrap loc__in">
    <div class="loc__img reveal-img">
      <Image src={img('hero/hero-7.jpg')} alt={es ? 'Camino entre montañas hacia Loma Nevada' : 'Mountain road to Loma Nevada'} widths={[480, 800, 1100]} sizes="(max-width: 900px) 100vw, 45vw" loading="lazy" data-parallax="0.05" />
    </div>
    <div class="loc__body">
      <span class="eyebrow reveal">{UX.howToGet[lang]}</span>
      <h2 id="loc-title" class="reveal">{es ? <>A 26 km de Santa Marta, <em>a otro ritmo</em></> : <>26 km from Santa Marta, <em>at another pace</em></>}</h2>
      <p class="reveal">{SITE.address.street}, Minca, Magdalena.</p>

      <dl class="loc__dist reveal">
        {DISTANCES.map((d) => <div><dt>{d.place[lang]}</dt><dd>{d.value[lang]}</dd></div>)}
      </dl>

      <div class="map reveal" data-map>
        <button type="button" class="map__load"><Icon name="pin" />{UX.howToGet[lang]} · {lang === 'es' ? 'ver mapa' : 'show map'}</button>
      </div>

      <div class="loc__links">
        <a class="link" href={href(lang, transport.slug[lang])}>{es ? 'Transporte desde Santa Marta' : 'Transport from Santa Marta'} <Icon name="arrow" /></a>
        <a class="link" href={SITE.mapsUrl} target="_blank" rel="noopener">{UI.openMap[lang]} <Icon name="arrow" /></a>
        <a class="link" href={waLink(UI.waGreeting[lang])} target="_blank" rel="noopener">WhatsApp {SITE.phoneDisplay}</a>
        <a class="link" href={href(lang, PAGES.contact[lang])}>{UI.contact[lang]} <Icon name="arrow" /></a>
      </div>
    </div>
  </div>
</section>

<script>
  // El mapa de Google solo se carga cuando la persona lo pide.
  document.querySelectorAll<HTMLElement>('#ubicacion [data-map]').forEach((m) => {
    m.querySelector('button')?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = 'https://www.google.com/maps?q=Loma+Nevada+Minca+Hotel,+El+Campano,+Minca&output=embed';
      f.title = 'Google Maps';
      f.loading = 'lazy';
      f.referrerPolicy = 'no-referrer-when-downgrade';
      m.replaceChildren(f);
    });
  });
</script>

<style>
  .loc__in { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 96px); align-items: center; }
  .loc__img { overflow: hidden; border-radius: var(--radius); }
  .loc__img :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; scale: 1.08; }
  .loc__body > p { color: var(--muted); }
  .loc__dist { display: grid; grid-template-columns: 1fr 1fr; gap: 0 28px; margin: 28px 0; }
  .loc__dist div { border-top: 1px solid var(--line); padding: 14px 0; }
  .loc__dist dt { font: 600 .75rem/1.3 var(--font-body); letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  .loc__dist dd { margin: 4px 0 0; font: 400 1.2rem/1.3 var(--font-head); color: var(--forest); }
  .map { position: relative; aspect-ratio: 16 / 9; border-radius: var(--radius); overflow: hidden; background: linear-gradient(135deg, #e3dccb, #cfd3bd); display: grid; place-items: center; }
  .map :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .map__load { display: inline-flex; align-items: center; gap: 8px; font: 600 .95rem var(--font-body); padding: 14px 22px; min-height: 48px; border-radius: 999px; border: 0; background: var(--paper); color: var(--forest); cursor: pointer; box-shadow: var(--shadow); }
  .map__load :global(svg) { width: 20px; height: 20px; }
  .loc__links { display: flex; flex-wrap: wrap; gap: 14px 28px; margin-top: 28px; }
  @media (max-width: 900px) {
    .loc__in { grid-template-columns: 1fr; }
    .loc__img :global(img) { aspect-ratio: 16 / 10; }
  }
</style>
